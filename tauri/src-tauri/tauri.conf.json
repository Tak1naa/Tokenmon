{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenMon Pet",
  "version": "2.0.0",
  "identifier": "io.github.tokenmon",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TokenMon Pet",
        "width": 64,
        "height": 64,
        "x": 300,
        "y": 200,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "center": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm"],
    "category": "Utility",
    "shortDescription": "LLM token 监控桌面宠物",
    "longDescription": "TokenMon Pet —— 精灵球收纳的桌面宠物，实时守护 LLM 网关 token 用量",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
